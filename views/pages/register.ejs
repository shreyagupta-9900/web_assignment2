<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>

  <%- include('../partials/navbar') %>

  <main class="main-wrapper">
    <div class="auth-box animate-fade-in" style="max-width: 520px;">
      <div style="text-align: center; margin-bottom: 24px;">
        <div class="brand-icon" style="margin: 0 auto 12px; width: 44px; height: 44px; font-size: 1.5rem;">
          <i class="bx bx-user-plus"></i>
        </div>
        <h1 style="font-size: 1.5rem; font-weight: 700;">Create LabScope Account</h1>
        <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px;">Institutional Access Registration</p>
      </div>

      <%- include('../partials/alerts') %>

      <form action="/register" method="POST">
        <div class="form-group">
          <label class="form-label" for="name">Full Name</label>
          <input type="text" id="name" name="name" class="form-control" placeholder="Dr. John Doe / Jane Smith" required />
        </div>

        <div class="form-group">
          <label class="form-label" for="email">Institutional Email</label>
          <input type="email" id="email" name="email" class="form-control" placeholder="username@lab.edu" required />
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div class="form-group">
            <label class="form-label" for="role">Account Role</label>
            <select id="role" name="role" class="form-control" required>
              <option value="requester">Student / Staff (Requester)</option>
              <option value="incharge">Lab In-Charge</option>
              <option value="admin">System Administrator</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="idNumber">Roll / Staff ID</label>
            <input type="text" id="idNumber" name="idNumber" class="form-control" placeholder="STU-1029 / STF-401" />
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="department">Department / Lab Group</label>
          <input type="text" id="department" name="department" class="form-control" placeholder="e.g. Electrical Engineering / Robotics" />
        </div>

        <div class="form-group">
          <label class="form-label" for="password">Password (min 6 characters)</label>
          <input type="password" id="password" name="password" class="form-control" placeholder="••••••••" minlength="6" required />
        </div>

        <button type="submit" class="btn btn-primary btn-hover" style="width: 100%; height: 46px; margin-top: 8px;">
          <i class="bx bx-check-circle"></i> Create Account
        </button>
      </form>

      <div style="text-align: center; margin-top: 20px; font-size: 0.85rem; color: var(--text-muted);">
        Already have an account? <a href="/login" style="color: var(--primary); font-weight: 600; text-decoration: none;">Sign in</a>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>

  <script type="module" src="/js/main.js"></script>
</body>
</html>
