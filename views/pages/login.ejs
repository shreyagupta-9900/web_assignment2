<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>

  <%- include('../partials/navbar') %>

  <main class="main-wrapper">
    <div class="auth-box animate-fade-in">
      <div style="text-align: center; margin-bottom: 24px;">
        <div class="brand-icon" style="margin: 0 auto 12px; width: 44px; height: 44px; font-size: 1.5rem;">
          <i class="bx bx-lock-alt"></i>
        </div>
        <h1 style="font-size: 1.5rem; font-weight: 700;">Sign In to LabScope</h1>
        <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px;">Enter your institutional account credentials</p>
      </div>

      <%- include('../partials/alerts') %>

      <form action="/login" method="POST">
        <div class="form-group">
          <label class="form-label" for="email">Institutional Email</label>
          <input type="email" id="email" name="email" class="form-control" placeholder="user@lab.edu" required />
        </div>

        <div class="form-group">
          <label class="form-label" for="password">Password</label>
          <input type="password" id="password" name="password" class="form-control" placeholder="••••••••" required />
        </div>

        <button type="submit" class="btn btn-primary btn-hover" style="width: 100%; height: 46px; margin-top: 8px;">
          <i class="bx bx-log-in"></i> Sign In
        </button>
      </form>

      <div style="text-align: center; margin-top: 20px; font-size: 0.85rem; color: var(--text-muted);">
        Don't have an account? <a href="/register" style="color: var(--primary); font-weight: 600; text-decoration: none;">Register here</a>
      </div>

      <!-- Quick 1-Click Demo Buttons -->
      <div style="margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--border-glass);">
        <p style="font-size: 0.8rem; font-weight: 600; color: var(--text-muted); text-align: center; margin-bottom: 10px;">
          ⚡ Or Sign In Instantly via Demo Role:
        </p>
        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px;">
          <a href="/demo-login/admin" class="btn btn-secondary btn-sm" style="text-align: center;">Admin</a>
          <a href="/demo-login/incharge" class="btn btn-secondary btn-sm" style="text-align: center;">In-Charge</a>
          <a href="/demo-login/requester" class="btn btn-secondary btn-sm" style="text-align: center;">Student</a>
        </div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>

  <script type="module" src="/js/main.js"></script>
</body>
</html>
