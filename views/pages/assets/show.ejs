<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../partials/head') %>
</head>
<body>

  <%- include('../../partials/navbar') %>

  <main class="main-wrapper">

    <div class="page-header">
      <div>
        <a href="/assets" style="color: var(--text-muted); font-size: 0.85rem; text-decoration: none; display: flex; align-items: center; gap: 4px; margin-bottom: 6px;">
          <i class="bx bx-left-arrow-alt"></i> Back to Equipment Catalog
        </a>
        <h1 class="page-title"><%= asset.name %></h1>
        <p class="page-subtitle">
          Asset Tag: <strong style="font-family: monospace;"><%= asset.assetTag %></strong> • <%= asset.category %>
        </p>
      </div>

      <div style="display: flex; gap: 10px;">
        <% if (asset.availableQuantity > 0) { %>
          <a href="/requests/new?assetId=<%= asset._id %>" class="btn btn-primary btn-hover">
            <i class="bx bx-plus-circle"></i> Borrow This Equipment
          </a>
        <% } %>

        <% if (currentUser.role === 'admin') { %>
          <a href="/assets/<%= asset._id %>/edit" class="btn btn-secondary btn-hover">
            <i class="bx bx-edit"></i> Edit Details
          </a>

          <form action="/assets/<%= asset._id %>/delete" method="POST" style="margin: 0;" onsubmit="return confirm('Are you sure you want to delete this asset from inventory?');">
            <button type="submit" class="btn btn-danger btn-hover">
              <i class="bx bx-trash"></i> Delete
            </button>
          </form>
        <% } %>
      </div>
    </div>

    <%- include('../../partials/alerts') %>

    <!-- Asset Spec & Stock Highlights Grid -->
    <div class="analytics-grid" style="margin-bottom: 28px;">
      <div class="chart-card">
        <h2 class="chart-title"><i class="bx bx-detail"></i> Technical Specifications & Location</h2>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px;">
          <div>
            <span style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase;">Lab Location</span>
            <div style="font-size: 1rem; font-weight: 600; margin-top: 2px;">
              <i class="bx bx-map-pin" style="color: var(--primary);"></i> <%= asset.labLocation %>
            </div>
          </div>

          <div>
            <span style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase;">Physical Condition</span>
            <div style="margin-top: 4px;">
              <span class="condition-pill <%= asset.condition.replace(/\s+/g, '') %>">
                <%= asset.condition %>
              </span>
            </div>
          </div>
        </div>

        <div>
          <span style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase;">Specifications & Features</span>
          <p style="margin-top: 6px; font-size: 0.95rem; line-height: 1.6; background: var(--bg-surface-subtle); padding: 14px; border-radius: 12px; border: 1px solid var(--border-glass);">
            <%= asset.specifications || 'No additional technical specifications provided.' %>
          </p>
        </div>
      </div>

      <!-- Stock Status Card -->
      <div class="chart-card">
        <h2 class="chart-title"><i class="bx bx-coin-stack"></i> Stock Availability</h2>
        
        <div style="text-align: center; padding: 16px 0;">
          <div style="font-size: 3rem; font-weight: 800; color: <%= asset.availableQuantity > 0 ? '#4ade80' : '#f87171' %>;">
            <%= asset.availableQuantity %> <span style="font-size: 1.2rem; color: var(--text-muted); font-weight: 500;">/ <%= asset.totalQuantity %></span>
          </div>
          <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px;">
            Units Ready for Immediate Issue
          </p>

          <div style="margin-top: 20px; padding: 14px; background: var(--bg-surface-subtle); border-radius: 12px; font-size: 0.85rem; text-align: left;">
            <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
              <span>Total Units Owned:</span>
              <strong><%= asset.totalQuantity %></strong>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
              <span>Currently Issued Out:</span>
              <strong style="color: #c084fc;"><%= asset.totalQuantity - asset.availableQuantity %></strong>
            </div>
            <div style="display: flex; justify-content: space-between;">
              <span>Available in Lab:</span>
              <strong style="color: #4ade80;"><%= asset.availableQuantity %></strong>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Historical Issue & Return Logs Table -->
    <div class="table-card">
      <div class="table-header">
        <h2 class="table-title">
          <i class="bx bx-history"></i>
          <span>Usage & Issue History Logs (<%= history.length %>)</span>
        </h2>
      </div>

      <div class="table-responsive">
        <table class="custom-table">
          <thead>
            <tr>
              <th>Requester</th>
              <th>Department / ID</th>
              <th>Quantity</th>
              <th>Purpose / Project</th>
              <th>Issue Date</th>
              <th>Return Date</th>
              <th>Status</th>
              <th>Condition</th>
            </tr>
          </thead>
          <tbody>
            <% if (!history || history.length === 0) { %>
              <tr>
                <td colspan="8" style="text-align: center; color: var(--text-muted); padding: 30px;">
                  No historical borrowing records for this equipment yet.
                </td>
              </tr>
            <% } else { %>
              <% history.forEach(function(item) { %>
                <tr>
                  <td><strong><%= item.requester ? item.requester.name : 'Unknown' %></strong></td>
                  <td><%= item.requester ? item.requester.department : '' %> (<%= item.requester ? item.requester.idNumber : '' %>)</td>
                  <td><%= item.quantity %></td>
                  <td style="max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                    <%= item.purpose %>
                  </td>
                  <td><%= item.issuedAt ? new Date(item.issuedAt).toLocaleDateString() : '—' %></td>
                  <td><%= item.returnedAt ? new Date(item.returnedAt).toLocaleDateString() : (item.expectedReturnDate ? new Date(item.expectedReturnDate).toLocaleDateString() : '—') %></td>
                  <td><span class="status-badge <%= item.status %>"><%= item.status %></span></td>
                  <td>
                    <% if (item.status === 'Returned') { %>
                      <span class="condition-pill <%= item.returnCondition %>"><%= item.returnCondition %></span>
                    <% } else { %>
                      —
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

  </main>

  <%- include('../../partials/footer') %>

  <script type="module" src="/js/main.js"></script>
</body>
</html>
