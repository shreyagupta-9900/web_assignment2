<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../partials/head') %>
</head>
<body>

  <%- include('../../partials/navbar') %>

  <main class="main-wrapper">

    <!-- Page Header -->
    <div class="page-header">
      <div>
        <h1 class="page-title">
          <i class="bx bx-cabinet"></i> Institutional Equipment & Asset Catalog
        </h1>
        <p class="page-subtitle">
          Browse, inspect specifications, and borrow laboratory instruments and assets.
        </p>
      </div>

      <div style="display: flex; gap: 10px;">
        <% if (currentUser.role === 'admin') { %>
          <a href="/assets/new" class="btn btn-primary btn-hover">
            <i class="bx bx-plus"></i> Add New Equipment
          </a>
        <% } %>
      </div>
    </div>

    <%- include('../../partials/alerts') %>

    <!-- Search & Filter Controls -->
    <div class="form-card" style="max-width: 100%; margin-bottom: 24px; padding: 20px;">
      <form action="/assets" method="GET" style="display: grid; grid-template-columns: 2fr 1fr 1fr auto auto; gap: 12px; align-items: center;">
        <div>
          <input
            type="text"
            name="search"
            class="form-control"
            placeholder="Search by equipment name, asset tag, or lab room..."
            value="<%= searchQuery %>"
          />
        </div>

        <div>
          <select name="category" class="form-control">
            <option value="All">All Categories</option>
            <% categories.forEach(function(cat) { %>
              <option value="<%= cat %>" <%= selectedCategory === cat ? 'selected' : '' %>><%= cat %></option>
            <% }); %>
          </select>
        </div>

        <div>
          <select name="condition" class="form-control">
            <option value="All">All Conditions</option>
            <option value="Good" <%= selectedCondition === 'Good' ? 'selected' : '' %>>Good</option>
            <option value="Fair" <%= selectedCondition === 'Fair' ? 'selected' : '' %>>Fair</option>
            <option value="Needs Maintenance" <%= selectedCondition === 'Needs Maintenance' ? 'selected' : '' %>>Needs Maintenance</option>
            <option value="Damaged" <%= selectedCondition === 'Damaged' ? 'selected' : '' %>>Damaged</option>
          </select>
        </div>

        <div style="display: flex; align-items: center; gap: 6px; white-space: nowrap;">
          <input type="checkbox" id="availableOnly" name="availableOnly" value="true" <%= availableOnly ? 'checked' : '' %>>
          <label for="availableOnly" style="font-size: 0.85rem; font-weight: 600; cursor: pointer;">Available Only</label>
        </div>

        <div style="display: flex; gap: 6px;">
          <button type="submit" class="btn btn-primary btn-sm">Filter</button>
          <a href="/assets" class="btn btn-secondary btn-sm" title="Reset Filters"><i class="bx bx-reset"></i></a>
        </div>
      </form>
    </div>

    <!-- Assets Inventory Table -->
    <div class="table-card">
      <div class="table-header">
        <h2 class="table-title">
          <i class="bx bx-list-check"></i>
          <span>Inventory Records (<%= assets.length %>)</span>
        </h2>
      </div>

      <div class="table-responsive">
        <table class="custom-table">
          <thead>
            <tr>
              <th>Asset Tag</th>
              <th>Equipment Name & Specs</th>
              <th>Category</th>
              <th>Lab Location</th>
              <th>Condition</th>
              <th>Stock (Avail / Total)</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (!assets || assets.length === 0) { %>
              <tr>
                <td colspan="7" style="text-align: center; color: var(--text-muted); padding: 40px;">
                  <i class="bx bx-search" style="font-size: 2.5rem; margin-bottom: 8px;"></i>
                  <p>No equipment matching your search/filter criteria.</p>
                </td>
              </tr>
            <% } else { %>
              <% assets.forEach(function(asset) { %>
                <%
                  const isAvailable = asset.availableQuantity > 0;
                  const stockPercent = Math.round((asset.availableQuantity / asset.totalQuantity) * 100);
                  const conditionClass = asset.condition.replace(/\s+/g, '');
                %>
                <tr>
                  <td>
                    <span style="font-family: monospace; font-weight: 700; background: var(--bg-surface-subtle); padding: 3px 8px; border-radius: 6px; border: 1px solid var(--border-glass);">
                      <%= asset.assetTag %>
                    </span>
                  </td>
                  <td>
                    <a href="/assets/<%= asset._id %>" style="color: var(--text-main); font-weight: 700; text-decoration: none;">
                      <%= asset.name %>
                    </a>
                    <% if (asset.specifications) { %>
                      <div style="font-size: 0.78rem; color: var(--text-muted); max-width: 320px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                        <%= asset.specifications %>
                      </div>
                    <% } %>
                  </td>
                  <td>
                    <span style="font-size: 0.85rem; color: var(--text-muted);"><%= asset.category %></span>
                  </td>
                  <td>
                    <div style="display: flex; align-items: center; gap: 4px; font-size: 0.85rem;">
                      <i class="bx bx-map-pin" style="color: var(--primary);"></i>
                      <%= asset.labLocation %>
                    </div>
                  </td>
                  <td>
                    <span class="condition-pill <%= conditionClass %>">
                      <%= asset.condition %>
                    </span>
                  </td>
                  <td>
                    <div style="display: flex; align-items: center; gap: 8px;">
                      <strong style="font-size: 0.95rem; color: <%= isAvailable ? '#4ade80' : '#f87171' %>">
                        <%= asset.availableQuantity %> / <%= asset.totalQuantity %>
                      </strong>
                      <div style="width: 50px; height: 6px; background: rgba(255,255,255,0.1); border-radius: 3px; overflow: hidden;">
                        <div style="width: <%= stockPercent %>%; height: 100%; background: <%= isAvailable ? '#4ade80' : '#f87171' %>;"></div>
                      </div>
                    </div>
                  </td>
                  <td>
                    <div style="display: flex; align-items: center; gap: 6px;">
                      <a href="/assets/<%= asset._id %>" class="btn btn-secondary btn-sm" title="View Details">
                        <i class="bx bx-info-circle"></i>
                      </a>

                      <% if (isAvailable) { %>
                        <a href="/requests/new?assetId=<%= asset._id %>" class="btn btn-primary btn-sm" title="Borrow Equipment">
                          <i class="bx bx-plus-circle"></i> Borrow
                        </a>
                      <% } else { %>
                        <span class="status-badge Overdue" style="font-size: 0.7rem;">Out of Stock</span>
                      <% } %>

                      <% if (currentUser.role === 'admin') { %>
                        <a href="/assets/<%= asset._id %>/edit" class="btn btn-secondary btn-sm" title="Edit Asset">
                          <i class="bx bx-edit"></i>
                        </a>

                        <form action="/assets/<%= asset._id %>/delete" method="POST" style="margin: 0;" onsubmit="return confirm('Are you sure you want to delete this asset?');">
                          <button type="submit" class="btn btn-danger btn-sm" title="Delete Asset">
                            <i class="bx bx-trash"></i>
                          </button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

  </main>

  <%- include('../../partials/footer') %>

  <script type="module" src="/js/main.js"></script>
</body>
</html>
